<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{company}} – {{profile.title}}</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&display=swap");

      * {
        box-sizing: border-box;
      }

      body {
        font-family: "Crimson Pro", serif;
        font-size: 11.5pt;
        line-height: 1.45;
        color: #000;
        width: 210mm;
        margin: 0 auto;
        padding: 20mm 25mm;
      }

      .sender {
        font-size: 9.5pt;
        color: #333;
      }

      .sender .sender-name {
        font-weight: 700;
        font-size: 15pt;
        color: #000;
        margin-bottom: 2mm;
      }

      .sender .sender-info {
        margin: 0;
        padding: 0;
        font-style: normal;
        color: #333;
      }

      .rule {
        border: none;
        border-bottom: 1.5px solid #000;
        margin: 6mm 0 4mm;
      }

      .recipient {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10mm;
        margin-bottom: 8mm;
      }

      .recipient .recipient-left {
        width: 78mm;
      }

      .recipient .clinic {
        font-weight: 700;
      }

      .recipient .sub-line {
        font-size: 9.5pt;
      }

      .date {
        text-align: right;
      }

      .subject {
        font-weight: 700;
        font-size: 12.5pt;
        margin: 2mm 0 6mm;
      }

      .body p {
        margin: 0 0 4mm;
        text-align: justify;
      }

      .closing {
        margin-top: 8mm;
        margin-bottom: 0;
      }

      .signature {
        margin-top: 8mm;
        font-weight: 700;
      }

      .signature .signature-photo {
        display: block;
        width: 26mm;
        height: auto;
        border-radius: 2mm;
        object-fit: cover;
        margin-bottom: 2mm;
      }
    </style>
  </head>
  <body>
<header class="sender">
      <div class="sender-name">{{profile.name}}</div>
      <address class="sender-info">{{#if profile.street}}{{profile.street}} | {{/if}}{{#if profile.postal}}{{profile.postal}} {{profile.city}} | {{/if}}{{#if profile.phone}}{{profile.phone}} | {{/if}}{{#if profile.email}}{{profile.email}}{{/if}}</address>
    </header>

    <hr class="rule" />

    <div class="recipient">
      <div class="recipient-left">
        <div class="clinic">{{company}}</div>
        {{#if consignee}}
          <div class="sub-line">{{consignee}}</div>
        {{/if}}
        {{#if location}}
          <div class="sub-line">{{location}}</div>
        {{/if}}
      </div>
      <div class="date">{{profile.city}}, {{date}}</div>
    </div>

    <div class="subject">{{profile.title}}</div>

    <div class="body">{{paragraphs text}}</div>

    {{! <p class="closing">Mit freundlichen Grüßen</p> }}
    <div class="signature">
      {{#if profile.photo}}
        <img class="signature-photo" src="{{profile.photo}}" alt="" />
      {{/if}}
      {{profile.name}}
    </div>
  </body>
</html>